# =============================================================================
# GOWRAX BOT — copie en .env et remplis chaque valeur
# =============================================================================

# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# MySQL YorkHost (game.yorkhost.fr → Databases)
# Si le mot de passe commence par =, mets-le entre guillemets : DB_PASSWORD="=xxx"
DB_HOST=mysql.yorkhost.fr
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Rôles Discord
ROLE_CASTER_STREAMER=
ROLE_STAFF=

# Channels Discord
CHANNEL_ABSENCES=
CHANNEL_MATCHS=
CHANNEL_LIVES=
CHANNEL_EVOLUTION=

# Tickets
CATEGORY_TICKETS=
TICKET_ROLE_HELP=
TICKET_ROLE_RECRUITMENT=

# Twitch (app type : Confidentielle)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_INTERVAL_MINUTES=5

# Bot
NOTIFICATION_POLL_INTERVAL_SECONDS=30
NODE_ENV=production
